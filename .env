# Presentation mode: 'phone-frame' (centered 420px frame on desktop) or 'responsive-web' (adaptive full width)
VITE_CONSUMER_PRESENTATION=phone-frame

# Enable Mock Service Worker (MSW) for API interception
VITE_ENABLE_MOCKS=true

# Show dev floating toolbar with demo shortcuts and reset button
VITE_DEMO_TOOLBAR=true

# API Base URL (point to real backend server when MSW is removed)
VITE_API_BASE_URL=/api
